l,"ancestors":[],"image":[{"url":"https://api.saundryaearth.com/uploads/categories/image-1760173643068-400170438.png","isPrimary":true}],"isActive":true,"displayOrder":0,"metaTitle":"Fragrances | Shop Perfumes & Colognes for Men & Women","metaDescription":"Discover captivating fragrances. Shop top-brand perfumes & colognes for men & women. Find your perfect signature scent & deals!","createdBy":"68d429745f666855fe99ac07","updatedBy":"68d429745f666855fe99ac07","createdAt":"2025-10-11T09:07:23.074Z","updatedAt":"2025-10-13T17:00:34.674Z","__v":0,"comingSoon":true},{"_id":"68ea1e166a3c67db42834503","name":"Travel and Gifting","slug":"travel-and-gifting","description":"Explore travel essentials & unique gifts for every occasion. Perfect for wanderlust & special moments. Find your next great item here!","parent":null,"ancestors":[],"image":[{"url":"https://api.saundryaearth.com/uploads/categories/image-1760173590265-827780898.png","isPrimary":true}],"isActive":true,"displayOrder":0,"metaTitle":"Travel & Gifting | Shop Essentials & Unique Gifts Online","metaDescription":"Discover premium travel gear & thoughtful gifts for all occasions. Find perfect items for your next adventure or a special someone. Shop now!","createdBy":"68d429745f666855fe99ac07","updatedBy":"68d429745f666855fe99ac07","createdAt":"2025-10-11T09:06:30.271Z","updatedAt":"2025-10-13T17:00:44.425Z","__v":0,"comingSoon":true},{"_id":"68ea1dcf6a3c67db428344f6","name":"Body Polish","slug":"body-polish","description":"Reveal smooth, radiant skin with our luxurious body polishes. Exfoliate, purify, and glow. Shop now for a spa-like experience at home.","parent":null,"ancestors":[],"image":[{"url":"https://api.saundryaearth.com/uploads/categories/image-1760173519308-980035059.png","isPrimary":true}],"isActive":true,"displayOrder":0,"metaTitle":"Body Polish - Exfoliating Scrubs for Smooth, Radiant Skin | Shop Now","metaDescription":"Discover premium body polishes for silky-smooth skin. Gently exfoliate, remove impurities & enhance your natural glow. Shop our selection today!","createdBy":"68d429745f666855fe99ac07","updatedBy":"68d429745f666855fe99ac07","createdAt":"2025-10-11T09:05:19.314Z","updatedAt":"2025-10-13T17:00:51.329Z","__v":0,"comingSoon":true},{"_id":"68ea1d9f6a3c67db428344ed","name":"Bath Oil","slug":"bath-oil","description":"Indulge in luxurious relaxation with our premium bath oils. Nourish your skin and soothe your senses. Perfect for a calming soak.","parent":null,"ancestors":[],"image":[{"url":"https://api.saundryaearth.com/uploads/categories/image-1760173471873-335076300.png","isPrimary":true}],"isActive":true,"displayOrder":0,"metaTitle":"Bath Oil | Luxury Skincare & Relaxation | Shop Now","metaDescription":"Discover our exquisite range of bath oils. Elevate your bath routine with hydrating formulas for soft skin & ultimate tranquility. Shop today!","createdBy":"68d429745f666855fe99ac07","updatedBy":"68d429745f666855fe99ac07","createdAt":"2025-10-11T09:04:31.878Z","updatedAt":"2025-10-13T17:00:56.993Z","__v":0,"comingSoon":true},{"_id":"68ea1d6c6a3c67db428344e4","name":"SPF","slug":"spf","description":"Protect your skin daily with our top-rated SPF products. Essential for healthy, youthful skin. Shop creams, sprays & more for all needs.","parent":null,"ancestors":[],"image":[{"url":"https://api.saundryaearth.com/uploads/categories/image-1760173420851-875536578.png","isPrimary":true}],"isActive":true,"displayOrder":0,"metaTitle":"Shop SPF | Sun Protection & Skincare | Healthy Skin Essentials","metaDescription":"Discover premium SPF for daily sun protection. Prevent sun damage & maintain radiant skin. Find your perfect sunscreen, lotion, or spray today!","createdBy":"68d429745f666855fe99ac07","updatedBy":"68d429745f666855fe99ac07","createdAt":"2025-10-11T09:03:40.857Z","updatedAt":"2025-10-13T17:01:03.362Z","__v":0,"comingSoon":true},{"_id":"68ea1d3b6a3c67db428344db","name":"Serum","slug":"serum","description":"Elevate your skincare with our potent serums.